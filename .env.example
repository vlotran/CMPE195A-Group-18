# Backend config: copy this file to `.env` in the repo root:
#     cp .env.example .env
# Then fill in your own values. `.env` is gitignored; never commit it.
# Only keys defined in backend/src/config/settings.py are allowed.


# Application
APP_NAME=Smart Hydroponic System
DEBUG=True
LOG_LEVEL=INFO

# API server
API_HOST=0.0.0.0
API_PORT=8000

# Database (relative to the repo root)
DATABASE_PATH=./data/hydroponic.db

# Sensors: True on laptops, False to use real sensors on hardware ends
USE_MOCK_SENSORS=False
SENSOR_READ_INTERVAL=30

# Optional: numeric user ID whose active plant profile is logged for actuator
# observation. GPIO outputs remain disabled regardless of this setting.
#ACTUATOR_PROFILE_USER_ID=1

# Physical relay control is disabled by default. Only enable on the Pi after
# verifying relay wiring, polarity, and loads. PID automatic control remains
# unavailable until its gains and switching timing are tested.
ACTUATOR_HARDWARE_ENABLED=False

# Name shown in the dashboard navbar (defaults to the machine hostname)
#CONTROLLER_NAME=hydro-pi

# CORS-comma-separated frontend origins, or * for any
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000