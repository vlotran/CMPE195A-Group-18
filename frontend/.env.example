# Frontend config - copy this file to `frontend/.env`:
#     cp frontend/.env.example frontend/.env
# Vite only exposes variables starting with VITE_ to the browser.
# Anything here ends up in the public JS bundle, never put secrets here.


# Backend base URL (no trailing slash)
#   Pi via ngrok (live sensors data on backend):    
#   Local backend (mock sensors data on backend): http://localhost:8000
VITE_API_BASE_URL=https://expedition-23.ngrok.app